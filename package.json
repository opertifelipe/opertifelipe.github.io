{
  "name": "opertifelipe-github-io",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "cv:pdf": "mkdir -p .cv-build && xelatex -halt-on-error -interaction=batchmode -no-shell-escape -output-directory .cv-build cv/Felipe_Operti_CV.tex && cp .cv-build/Felipe_Operti_CV.pdf public/Felipe_Operti_CV.pdf",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
