---
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import BashTerminal from '../components/BashTerminal.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const terminalDocuments = await getCollection('terminal');
const blogPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const documents = await Promise.all([
  ...terminalDocuments.map(async (document) => ({
    path: document.data.path,
    title: document.data.title,
    description: document.data.description,
    html: await marked.parse(document.body || ''),
    markdown: document.body || '',
  })),
  ...blogPosts.map(async (post) => ({
    path: `blog/${post.id}.md`,
    title: post.data.title,
    description: post.data.description,
    html: await marked.parse(post.body || ''),
    markdown: post.body || '',
    modified: post.data.publishedAt.toISOString(),
    tags: post.data.tags,
  })),
]);
---

<BaseLayout
  title="Felipe Operti"
  description="Navigate Felipe Operti's work, CV and writing through an interactive Bash portfolio."
>
  <BashTerminal documents={documents} />
</BaseLayout>
