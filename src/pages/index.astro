---
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import PortfolioShell from '../components/PortfolioShell.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const staticDocuments = await getCollection('documents');
const blogPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const documents = await Promise.all([
  ...staticDocuments.map(async (document) => ({
    path: document.data.path,
    title: document.data.title,
    description: document.data.description,
    html: await marked.parse(document.body || ''),
    markdown: document.body || '',
  })),
  ...blogPosts.map(async (post) => ({
    path: `blog/${post.id}.md`,
    title: post.data.title,
    description: post.data.description,
    html: await marked.parse(post.body || ''),
    markdown: post.body || '',
    modified: post.data.publishedAt.toISOString(),
    tags: post.data.tags,
  })),
]);
---

<BaseLayout
  title="Felipe Operti"
  description="Explore Felipe Operti's work, CV and writing through a file explorer or interactive Bash terminal."
>
  <PortfolioShell documents={documents} />
</BaseLayout>
