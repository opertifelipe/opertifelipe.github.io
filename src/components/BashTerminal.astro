---
interface TerminalDocument {
  path: string;
  title: string;
  description: string;
  html: string;
  markdown: string;
  modified?: string;
  tags?: string[];
}

interface Props {
  documents?: TerminalDocument[];
}

const { documents = [] } = Astro.props;
const serializedDocuments = JSON.stringify(documents).replaceAll('<', '\\u003c');
---

<section class="bash-terminal" data-bash-terminal aria-label="Interactive portfolio terminal">
  <div class="terminal-output" data-output aria-live="polite"></div>

  <form class="command-form" data-form autocomplete="off">
    <label class="sr-only" for="terminal-command">Enter a terminal command</label>
    <span class="live-prompt" aria-hidden="true">
      <strong>felipe@galileo</strong>:<span data-prompt-path>~</span>$
    </span>
    <input
      id="terminal-command"
      data-input
      name="command"
      type="text"
      inputmode="text"
      autocapitalize="none"
      autocomplete="off"
      autocorrect="off"
      spellcheck="false"
      aria-describedby="terminal-hint"
    />
  </form>

  <p class="footer-hint">
    type <button type="button" data-command="help">help</button> for available commands
  </p>

  <p id="terminal-hint" class="sr-only">
    Type help to list commands. Use Tab to autocomplete and the arrow keys to navigate command history.
  </p>

  <noscript>JavaScript is required to use this terminal.</noscript>
</section>

<dialog class="image-viewer" data-image-viewer>
  <form method="dialog">
    <button type="submit" aria-label="Close image viewer">[ close ]</button>
  </form>
  <figure>
    <img data-viewer-image src="" alt="" />
    <figcaption data-viewer-caption></figcaption>
  </figure>
</dialog>

<script type="application/json" id="terminal-documents" set:html={serializedDocuments} is:inline></script>

<script>
  type EntryType = 'directory' | 'markdown' | 'image' | 'pdf';

  interface Entry {
    name: string;
    type: EntryType;
    documentPath?: string;
    source?: string;
    description?: string;
    modified?: string;
  }

  interface TerminalDocument {
    path: string;
    title: string;
    description: string;
    html: string;
    markdown: string;
    modified?: string;
    tags?: string[];
  }

  const terminal = document.querySelector<HTMLElement>('[data-bash-terminal]');
  const output = document.querySelector<HTMLElement>('[data-output]');
  const form = document.querySelector<HTMLFormElement>('[data-form]');
  const input = document.querySelector<HTMLInputElement>('[data-input]');
  const promptPath = document.querySelector<HTMLElement>('[data-prompt-path]');
  const viewer = document.querySelector<HTMLDialogElement>('[data-image-viewer]');
  const viewerImage = document.querySelector<HTMLImageElement>('[data-viewer-image]');
  const viewerCaption = document.querySelector<HTMLElement>('[data-viewer-caption]');
  const documentsData = document.querySelector<HTMLScriptElement>('#terminal-documents');

  if (!terminal || !output || !form || !input || !promptPath || !viewer || !viewerImage || !viewerCaption || !documentsData) {
    throw new Error('Terminal could not be initialized.');
  }

  const HOME = '/home/felipe';
  const commands = ['help', 'man', 'ls', 'cd', 'pwd', 'cat', 'open', 'xdg-open', 'tree', 'file', 'download', 'whoami', 'history', 'clear', 'date', 'uname', 'echo'];
  const documents = JSON.parse(documentsData.textContent || '[]') as TerminalDocument[];
  const documentMap = new Map(documents.map((document) => [document.path, document]));
  const commandHistory: string[] = [];
  let historyIndex = 0;
  let cwd = HOME;

  const markdownEntry = (path: string): Entry => {
    const document = documentMap.get(path);
    return {
      name: path.split('/').at(-1) || path,
      type: 'markdown',
      documentPath: path,
      description: document?.description,
      modified: document?.modified,
    };
  };

  const fileSystem: Record<string, Entry[]> = {
    '/': [{ name: 'home', type: 'directory' }],
    '/home': [{ name: 'felipe', type: 'directory' }],
    [HOME]: [
      markdownEntry('about.md'),
      { name: 'cv', type: 'directory' },
      { name: 'projects', type: 'directory' },
      { name: 'blog', type: 'directory' },
      markdownEntry('contacts.md'),
      markdownEntry('why.md'),
    ],
    [HOME + '/cv']: [
      markdownEntry('cv/README.md'),
      { name: 'Felipe_Operti_CV.pdf', type: 'pdf', source: '/Felipe_Operti_CV.pdf', description: 'Downloadable curriculum vitae.' },
    ],
    [HOME + '/projects']: [{ name: 'honai', type: 'directory' }],
    [HOME + '/projects/honai']: [
      markdownEntry('projects/honai/README.md'),
      { name: 'images', type: 'directory' },
    ],
    [HOME + '/projects/honai/images']: [
      { name: 'bee.webp', type: 'image', source: '/images/honai-cover.webp', description: 'Bee collecting pollen from a flower.' },
      { name: 'batch-architecture.webp', type: 'image', source: '/images/honai-batch.webp', description: 'HonAI batch prediction architecture.' },
      { name: 'api-architecture.webp', type: 'image', source: '/images/honai-api.webp', description: 'HonAI API and monitoring architecture.' },
    ],
    [HOME + '/blog']: [markdownEntry('blog/README.md')],
  };

  documents
    .filter((document) => document.path.startsWith('blog/') && document.path !== 'blog/README.md')
    .forEach((document) => {
      const parts = document.path.slice('blog/'.length).split('/');
      let currentPath = HOME + '/blog';

      parts.forEach((part, index) => {
        const isFile = index === parts.length - 1;
        if (isFile) {
          fileSystem[currentPath].push(markdownEntry(document.path));
          return;
        }

        if (!fileSystem[currentPath].some((entry) => entry.type === 'directory' && entry.name === part)) {
          fileSystem[currentPath].push({ name: part, type: 'directory' });
        }
        currentPath += '/' + part;
        fileSystem[currentPath] ||= [];
      });
    });

  const escapeHtml = (value: string) =>
    value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');

  const displayPath = (path: string) => {
    if (path === HOME) return '~';
    if (path.startsWith(HOME + '/')) return '~' + path.slice(HOME.length);
    return path;
  };

  const normalizePath = (value = '.') => {
    let candidate = value.trim() || '.';
    if (candidate === '~') candidate = HOME;
    if (candidate.startsWith('~/')) candidate = HOME + candidate.slice(1);
    if (!candidate.startsWith('/')) candidate = cwd + '/' + candidate;

    const parts: string[] = [];
    for (const part of candidate.split('/')) {
      if (!part || part === '.') continue;
      if (part === '..') parts.pop();
      else parts.push(part);
    }
    return '/' + parts.join('/');
  };

  const getEntry = (path: string) => {
    const normalized = normalizePath(path);
    const separator = normalized.lastIndexOf('/');
    const parent = separator === 0 ? '/' : normalized.slice(0, separator);
    const name = normalized.slice(separator + 1);
    return fileSystem[parent]?.find((entry) => entry.name === name);
  };

  const appendHtml = (html: string, className = 'command-result') => {
    const block = document.createElement('div');
    block.className = className;
    block.innerHTML = html;
    output.append(block);
    return block;
  };

  const appendCommandLine = (command: string) => {
    appendHtml(
      '<span class="history-prompt"><strong>felipe@galileo</strong>:' +
        escapeHtml(displayPath(cwd)) +
        '$</span> <span class="history-command">' +
        escapeHtml(command) +
        '</span>',
      'command-history-line',
    );
  };

  const error = (message: string) => {
    appendHtml('<span class="error-message">bash: ' + escapeHtml(message) + '</span>');
  };

  const commandButton = (label: string, command: string, className = '') =>
    '<button type="button" class="output-link ' +
    className +
    '" data-command="' +
    escapeHtml(command) +
    '">' +
    escapeHtml(label) +
    '</button>';

  const entryCommand = (entry: Entry, basePath = cwd) => {
    const target = displayPath(normalizePath(basePath + '/' + entry.name));
    if (entry.type === 'directory') return 'cd ' + target;
    if (entry.type === 'image') return 'open ' + target;
    if (entry.type === 'pdf') return 'download ' + target;
    return 'cat ' + target;
  };

  const listDirectory = (path: string, longFormat: boolean, sortByTime: boolean) => {
    const entries = fileSystem[path];
    if (!entries) {
      const entry = getEntry(path);
      if (entry) {
        const parent = path.slice(0, path.lastIndexOf('/')) || '/';
        appendHtml(commandButton(entry.name, entryCommand(entry, parent), 'entry-' + entry.type));
      } else {
        error('ls: cannot access ' + displayPath(path) + ': No such file or directory');
      }
      return;
    }

    const sorted = [...entries];
    if (sortByTime) {
      sorted.sort((a, b) => (b.modified || '').localeCompare(a.modified || ''));
    }

    if (longFormat) {
      const rows = sorted.map((entry) => {
        const permissions = entry.type === 'directory' ? 'drwxr-xr-x' : '-rw-r--r--';
        const date = entry.modified
          ? new Intl.DateTimeFormat('en-CA', { dateStyle: 'medium' }).format(new Date(entry.modified))
          : '—';
        return (
          '<li><span class="permissions">' + permissions + '</span><span class="entry-date">' +
          escapeHtml(date) + '</span>' +
          commandButton(entry.name + (entry.type === 'directory' ? '/' : ''), entryCommand(entry, path), 'entry-' + entry.type) +
          '</li>'
        );
      }).join('');
      appendHtml('<ul class="long-list">' + rows + '</ul>');
      return;
    }

    const items = sorted
      .map((entry) => commandButton(entry.name + (entry.type === 'directory' ? '/' : ''), entryCommand(entry, path), 'entry-' + entry.type))
      .join('');
    appendHtml('<div class="directory-list">' + items + '</div>');
  };

  const renderHelp = () => {
    appendHtml(
      '<div class="rich-output help-output">' +
        '<p>Available commands:</p><dl>' +
        '<div><dt>' + commandButton('ls [-la] [path]', 'ls') + '</dt><dd>list files and directories</dd></div>' +
        '<div><dt>' + commandButton('cd [path]', 'cd') + '</dt><dd>change the current directory</dd></div>' +
        '<div><dt>cat file.md</dt><dd>render Markdown, including images, in the terminal</dd></div>' +
        '<div><dt>open image.webp</dt><dd>display a colour image</dd></div>' +
        '<div><dt>download file</dt><dd>download a Markdown document or PDF</dd></div>' +
        '<div><dt>' + commandButton('tree [path]', 'tree') + '</dt><dd>show the virtual filesystem</dd></div>' +
        '<div><dt>pwd · file · history</dt><dd>inspect the current session</dd></div>' +
        '<div><dt>' + commandButton('clear', 'clear') + '</dt><dd>clear the terminal</dd></div>' +
        '</dl><p class="hint-line">Names printed by ls are clickable. Tab completes commands and paths.</p>' +
      '</div>',
    );
  };

  const renderLanding = () => {
    appendHtml(
      '<header class="landing-message"><h1>Felipe Operti</h1>' +
        '<p>AI Architect and AI Engineer</p>' +
        '<p><a href="mailto:operti.felipe@gmail.com">operti.felipe@gmail.com</a></p></header>',
      'landing-wrapper',
    );
  };

  const resetView = () => {
    output.replaceChildren();
    renderLanding();
    window.scrollTo({ top: 0 });
  };

  const renderMarkdown = (entry: Entry, path: string) => {
    if (!entry.documentPath) {
      error('cat: ' + displayPath(path) + ': Cannot read document');
      return;
    }
    const document = documentMap.get(entry.documentPath);
    if (!document) {
      error('cat: ' + displayPath(path) + ': Cannot read document');
      return;
    }
    appendHtml(
      '<article class="rich-output markdown-output' + (entry.documentPath === 'about.md' ? ' document-about' : '') + '">' +
        '<p class="document-path">' + escapeHtml(displayPath(path)) + ' · ' +
          commandButton('[download]', 'download ' + displayPath(path)) + '</p>' +
        document.html +
      '</article>',
    );
  };

  const readFile = (path: string) => {
    const normalized = normalizePath(path);
    const entry = getEntry(normalized);
    if (!entry) {
      error('cat: ' + path + ': No such file or directory');
      return;
    }
    if (entry.type === 'directory') {
      error('cat: ' + path + ': Is a directory');
      return;
    }
    if (entry.type === 'image' || entry.type === 'pdf') {
      error('cat: ' + path + ': Binary file');
      return;
    }
    renderMarkdown(entry, normalized);
  };

  const openFile = (path: string) => {
    const normalized = normalizePath(path);
    const entry = getEntry(normalized);
    if (!entry) {
      error('open: ' + path + ': No such file or directory');
    } else if (entry.type === 'directory') {
      error('open: ' + path + ': Is a directory');
    } else if (entry.type === 'image') {
      openImage(normalized);
    } else if (entry.type === 'pdf' && entry.source) {
      window.location.assign(entry.source);
    } else {
      renderMarkdown(entry, normalized);
    }
  };

  const openImage = (path: string) => {
    const normalized = normalizePath(path);
    const entry = getEntry(normalized);
    if (!entry || entry.type !== 'image' || !entry.source) {
      error('open: ' + path + ': Not an image file');
      return;
    }
    appendHtml(
      '<figure class="inline-image"><button type="button" data-image="' + escapeHtml(entry.source) +
      '" data-caption="' + escapeHtml(entry.description || entry.name) + '"><img src="' +
      escapeHtml(entry.source) + '" alt="' + escapeHtml(entry.description || entry.name) +
      '" /></button><figcaption>' + escapeHtml(entry.description || entry.name) +
      ' · click to enlarge</figcaption></figure>',
    );
  };

  const renderTree = (path: string) => {
    const normalized = normalizePath(path || '.');
    if (!fileSystem[normalized]) {
      error('tree: ' + path + ': No such directory');
      return;
    }
    const lines: string[] = [displayPath(normalized)];
    const walk = (current: string, prefix: string) => {
      const entries = fileSystem[current] || [];
      entries.forEach((entry, index) => {
        const last = index === entries.length - 1;
        lines.push(prefix + (last ? '└── ' : '├── ') + entry.name + (entry.type === 'directory' ? '/' : ''));
        const child = current === '/' ? '/' + entry.name : current + '/' + entry.name;
        if (entry.type === 'directory' && fileSystem[child]) walk(child, prefix + (last ? '    ' : '│   '));
      });
    };
    walk(normalized, '');
    appendHtml('<pre class="tree-output">' + escapeHtml(lines.join('\n')) + '</pre>');
  };

  const changeDirectory = (path?: string) => {
    const target = normalizePath(path || '~');
    if (!fileSystem[target]) {
      const entry = getEntry(target);
      error('cd: ' + (path || '') + ': ' + (entry ? 'Not a directory' : 'No such file or directory'));
      return;
    }
    cwd = target;
    promptPath.textContent = displayPath(cwd);
    history.pushState({ cwd }, '', '#' + displayPath(cwd));
    if (!path) resetView();
  };

  const downloadFile = (path: string) => {
    const entry = getEntry(normalizePath(path));
    if (!entry || (entry.type !== 'pdf' && entry.type !== 'markdown')) {
      error('download: ' + path + ': File is not downloadable');
      return;
    }

    let source = entry.source;
    if (entry.type === 'markdown' && entry.documentPath) {
      const document = documentMap.get(entry.documentPath);
      if (!document) {
        error('download: ' + path + ': Cannot read document');
        return;
      }
      source = URL.createObjectURL(new Blob([document.markdown], { type: 'text/markdown;charset=utf-8' }));
    }

    if (!source) {
      error('download: ' + path + ': File is not downloadable');
      return;
    }
    const anchor = document.createElement('a');
    anchor.href = source;
    anchor.download = entry.name;
    document.body.append(anchor);
    anchor.click();
    anchor.remove();
    if (entry.type === 'markdown') URL.revokeObjectURL(source);
    appendHtml('download started: ' + escapeHtml(entry.name));
  };

  const tokenize = (value: string) => {
    const matches = value.match(/(?:[^\s"]+|"[^"]*")+/g) || [];
    return matches.map((token) => token.replace(/^"|"$/g, ''));
  };

  const runSingleCommand = (rawCommand: string) => {
    const tokens = tokenize(rawCommand);
    const command = tokens.shift()?.toLowerCase();
    if (!command) return;

    switch (command) {
      case 'help':
      case 'man':
        renderHelp();
        break;
      case 'pwd':
        appendHtml(escapeHtml(cwd));
        break;
      case 'ls': {
        const flags = tokens.filter((token) => token.startsWith('-')).join('');
        const requestedPath = tokens.find((token) => !token.startsWith('-')) || '.';
        listDirectory(normalizePath(requestedPath), flags.includes('l'), flags.includes('t'));
        break;
      }
      case 'cd':
        changeDirectory(tokens[0]);
        break;
      case 'cat':
        if (!tokens[0]) error(command + ': missing file operand');
        else readFile(tokens[0]);
        break;
      case 'open':
      case 'xdg-open':
        if (!tokens[0]) error(command + ': missing file operand');
        else openFile(tokens[0]);
        break;
      case 'tree':
        renderTree(tokens[0] || '.');
        break;
      case 'file': {
        if (!tokens[0]) error('file: missing file operand');
        else {
          const entry = getEntry(normalizePath(tokens[0]));
          if (!entry) error('file: ' + tokens[0] + ': No such file');
          else appendHtml(escapeHtml(entry.name + ': ' + entry.type));
        }
        break;
      }
      case 'download':
        if (!tokens[0]) error('download: missing file operand');
        else downloadFile(tokens[0]);
        break;
      case 'whoami':
        appendHtml('felipe');
        break;
      case 'date':
        appendHtml(escapeHtml(new Date().toString()));
        break;
      case 'uname':
        appendHtml(tokens.includes('-a') ? 'Linux galileo 6.8.0 #1 SMP x86_64 GNU/Linux' : 'Linux');
        break;
      case 'echo':
        appendHtml(escapeHtml(tokens.join(' ')));
        break;
      case 'history':
        appendHtml('<ol class="history-list">' + commandHistory.map((item, index) => '<li><span>' + (index + 1) + '</span>' + escapeHtml(item) + '</li>').join('') + '</ol>');
        break;
      case 'clear':
        resetView();
        break;
      default:
        error(command + ': command not found');
    }
  };

  const runCommand = (rawCommand: string) => {
    const command = rawCommand.trim();
    if (!command) return;
    appendCommandLine(command);
    commandHistory.push(command);
    historyIndex = commandHistory.length;
    command.split(/\s*&&\s*/).filter(Boolean).forEach(runSingleCommand);
    input.value = '';
    requestAnimationFrame(() => window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' }));
  };

  const completeInput = () => {
    const tokens = input.value.split(/\s+/);
    const currentToken = tokens.at(-1) || '';
    if (tokens.length === 1) {
      const matches = commands.filter((command) => command.startsWith(currentToken));
      if (matches.length === 1) input.value = matches[0] + ' ';
      else if (matches.length > 1) appendHtml('<div class="completion-list">' + matches.map(escapeHtml).join('  ') + '</div>');
      return;
    }

    const slash = currentToken.lastIndexOf('/');
    const prefix = slash >= 0 ? currentToken.slice(0, slash + 1) : '';
    const fragment = slash >= 0 ? currentToken.slice(slash + 1) : currentToken;
    const directoryPath = normalizePath(prefix || '.');
    const matches = (fileSystem[directoryPath] || []).filter((entry) => entry.name.startsWith(fragment));
    if (matches.length === 1) {
      tokens[tokens.length - 1] = prefix + matches[0].name + (matches[0].type === 'directory' ? '/' : '');
      input.value = tokens.join(' ');
    } else if (matches.length > 1) {
      appendHtml('<div class="completion-list">' + matches.map((entry) => escapeHtml(entry.name)).join('  ') + '</div>');
    }
  };

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    runCommand(input.value);
  });

  input.addEventListener('keydown', (event) => {
    if (event.key === 'Tab') {
      event.preventDefault();
      completeInput();
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      if (historyIndex > 0) historyIndex -= 1;
      input.value = commandHistory[historyIndex] || '';
    } else if (event.key === 'ArrowDown') {
      event.preventDefault();
      if (historyIndex < commandHistory.length) historyIndex += 1;
      input.value = commandHistory[historyIndex] || '';
    } else if (event.ctrlKey && event.key.toLowerCase() === 'l') {
      event.preventDefault();
      resetView();
    } else if (event.ctrlKey && event.key.toLowerCase() === 'c') {
      event.preventDefault();
      appendCommandLine(input.value + '^C');
      input.value = '';
    }
  });

  const showImage = (source: string, caption: string) => {
    viewerImage.src = source;
    viewerImage.alt = caption;
    viewerCaption.textContent = caption;
    viewer.showModal();
  };

  terminal.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const commandTarget = target.closest<HTMLElement>('[data-command]');
    const imageTarget = target.closest<HTMLElement>('[data-image]');
    const markdownImage = target.closest<HTMLImageElement>('.markdown-output img');

    if (commandTarget?.dataset.command) {
      runCommand(commandTarget.dataset.command);
      input.focus();
    } else if (imageTarget?.dataset.image) {
      showImage(imageTarget.dataset.image, imageTarget.dataset.caption || 'Project image');
    } else if (markdownImage) {
      showImage(markdownImage.currentSrc || markdownImage.src, markdownImage.alt || 'Document image');
    } else if (!target.closest('a, button, input')) {
      input.focus();
    }
  });

  window.addEventListener('popstate', () => {
    const hashPath = decodeURIComponent(window.location.hash.slice(1));
    const target = hashPath ? normalizePath(hashPath) : HOME;
    if (fileSystem[target]) {
      cwd = target;
      promptPath.textContent = displayPath(cwd);
      resetView();
    }
  });

  const initialHashPath = decodeURIComponent(window.location.hash.slice(1));
  const initialPath = initialHashPath ? normalizePath(initialHashPath) : HOME;
  if (fileSystem[initialPath]) cwd = initialPath;
  promptPath.textContent = displayPath(cwd);

  renderLanding();

</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .bash-terminal {
    display: flex;
    min-height: calc(100svh - clamp(1.5rem, 6vw, 5rem));
    flex-direction: column;
    padding: 0 clamp(0.25rem, 2vw, 1.5rem);
    font-size: clamp(0.82rem, 1.2vw, 1rem);
  }

  .terminal-output {
    flex: 1;
  }

  .terminal-output :global(.landing-wrapper) {
    display: grid;
    min-height: calc(100svh - 9rem);
    place-items: center;
  }

  .terminal-output :global(.landing-message) {
    text-align: center;
  }

  .terminal-output :global(.landing-message h1) {
    margin: 0 0 0.6rem;
    color: #fff;
    font-size: clamp(2rem, 7vw, 5.5rem);
    letter-spacing: -0.06em;
    text-shadow:
      1px 1px 0 #d0d0d0,
      2px 2px 0 #a0a0a0,
      3px 3px 0 #707070,
      4px 4px 0 #404040,
      5px 5px 0 #181818,
      9px 9px 18px #000;
  }

  .terminal-output :global(.landing-message p) {
    margin: 0.3rem 0;
  }

  .terminal-output :global(.landing-message a) {
    color: #fff;
  }

  .terminal-output :global(.command-history-line) {
    margin-top: 1.4rem;
  }

  .terminal-output :global(.history-prompt),
  .live-prompt {
    color: #aaa;
  }

  .terminal-output :global(.history-prompt strong),
  .live-prompt strong {
    color: #fff;
    font-weight: 600;
